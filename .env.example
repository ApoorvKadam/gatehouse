# Desk
DESK_DATABASE_URL=sqlite:///./data/desk.db
DESK_FMS_BASE_URL=http://localhost:8100
DESK_FMS_API_KEY=sim_org_northstar_full
# Seconds to wait for the FMS before treating a payment response as lost
DESK_FMS_TIMEOUT_SECONDS=5
# Every desk route needs X-Desk-Token: <this>. Without it the API refuses requests.
DESK_OPERATOR_TOKEN=
# Set to 1 only on a laptop to run without a token
DESK_ALLOW_WITHOUT_TOKEN=0
# Resolving a payment held for staff also needs X-Staff-Token: <this>. Without it that route is closed.
DESK_STAFF_TOKEN=
# Cubby's SMS Received webhook must send X-Webhook-Token: <this>. Cubby documents no signing, so a gateway such as Make.com adds it.
# Without it the receiver is closed.
DESK_WEBHOOK_TOKEN=
# Which facility a receiving number belongs to, for numbers that several facilities share. JSON, for example
# {"+14075550100": "fac_NSorlando01"}. Without it, such a text is kept as unrouted.
DESK_TEXT_NUMBERS=
# The hosted preview: build the synthetic world on an empty database, and let anyone read it without a token.
# The public view starts only together with the synthetic world and the local simulator.
DESK_DEMO_SEED=0
DESK_PUBLIC_VIEW=0
# the preview only: let any visitor prepare a case live on a seeded text, within the day's limits below
DESK_PUBLIC_INVESTIGATE=0
DESK_DAILY_BUDGET_USD=1
DESK_VISITOR_CASES_PER_DAY=10
# the bot check in front of typing a text and starting a run (desk/guard.py). On only when both keys are set; one key alone closes
# both paths. The host is the address the check must have been passed on.
DESK_TURNSTILE_SITEKEY=
DESK_TURNSTILE_SECRET=
DESK_TURNSTILE_HOST=

# FMS simulator
SIM_DATABASE_URL=sqlite:///./data/fmssim.db

# Tenant conversation (optional; the desk runs without it)
ANTHROPIC_API_KEY=
DESK_CHAT_MODEL=claude-haiku-5-5
